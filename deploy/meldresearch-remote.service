# Meld Research remote backend (blue site) behind nginx on www.meldresearch.org.
# Install once: sudo install -m 0644 meldresearch-remote.service /etc/systemd/system/ (README "Server setup").
# Runs as markusmobius from the deployed release in the repository clone; data and configuration live in
# ~/meldresearch-data. It may write only there; the rest of the home folder is read-only to it.

[Unit]
Description=Meld Research remote backend
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=markusmobius
Group=markusmobius
WorkingDirectory=/home/markusmobius/meldresearch/deployed/current
ExecStart=/home/markusmobius/meldresearch/deployed/current/MeldResearch.RemoteBackend

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=MELDRESEARCH_PublicOrigin=https://www.meldresearch.org
Environment=MELDRESEARCH_ListenAddress=127.0.0.1
Environment=MELDRESEARCH_Port=8080
Environment=MELDRESEARCH_DataDirectory=/home/markusmobius/meldresearch-data/remote
Environment=MELDRESEARCH_DownloadDirectory=/home/markusmobius/meldresearch-data/downloads
Environment=MELDRESEARCH_DataProtection__CertificatePath=/home/markusmobius/meldresearch-data/dataprotection.pfx
EnvironmentFile=/home/markusmobius/meldresearch-data/remote.env
EnvironmentFile=/home/markusmobius/meldresearch-data/dataprotection.env

UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SyslogIdentifier=meldresearch-remote

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/markusmobius/meldresearch-data
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
