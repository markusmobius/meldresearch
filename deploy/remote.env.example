# ~/meldresearch-data/remote.env -- mode 0600, owned by the user the service runs as (markusmobius).
# Every value here is non-secret; keep any secrets you add (such as a Foundry API key) only on the server.
# Comment out a line (with #) to leave that setting unconfigured deliberately.

# Sign in with Google: only the public OAuth "Web application" client ID; no client secret is used.
# In the Google console, add https://www.meldresearch.org under "Authorized JavaScript origins".
MELDRESEARCH_Google__ClientId=377614800302-esd0j10vus4beptjt10asq3fl3o1helv.apps.googleusercontent.com

# Azure AI Foundry: the meldllm resource (Central US). The endpoint must be
# the Azure OpenAI .../openai/v1/ base URL, not the Foundry project endpoint.
MELDRESEARCH_Foundry__Endpoint=https://meldllm.openai.azure.com/openai/v1/
MELDRESEARCH_Foundry__ChatDeployment=gpt-6-luna
MELDRESEARCH_Foundry__EmbeddingDeployment=text-embedding-3-large

# Foundry authentication: the Azure VM's user-assigned managed identity (no secret on the server).
# It needs "Cognitive Services OpenAI User" on meldllm. The Client ID is not a secret.
MELDRESEARCH_Foundry__ManagedIdentityClientId=16bb0c7d-e97f-42f7-a806-9bf3e2df6752
# Only for servers without a managed identity: an API key, which takes precedence.
# MELDRESEARCH_Foundry__ApiKey=

# OpenAlex (researcher matching): a secret API key from openalex.org. Add it only in the server's copy;
# without it, requests are anonymous and share OpenAlex's much lower anonymous limits.
# MELDRESEARCH_OpenAlex__ApiKey=
